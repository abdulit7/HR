        <script>    
            function handlethemeview() {
                $('#theme_view').change(function () {
                    if ($(this).is(":checked")) {

                        PageMethods.SetSessionValue('Theme', true, null, null);
                    } else {

                        PageMethods.SetSessionValue('Theme', false, null, null);
                    }
                });
            }; Elegant Theme Side Menu Open OnClick
        </script>
        <script>
            $(function () {
                "use strict";
                $("#main-wrapper").AdminSettings({
                    Theme: 'skin5', // this can be true or false ( true means dark and false means light ),
                    Layout: 'vertical',
                    LogoBg: 'skin5',//document.getElementById('LogoBg');, // You can change the Value to be skin1/skin2/skin3/skin4/skin5/skin6 
                    NavbarBg: 'skin5', // You can change the Value to be skin1/skin2/skin3/skin4/skin5/skin6
                    SidebarType: 'full', // You can change it full / mini-sidebar / iconbar / overlay
                    SidebarColor: 'skin5', // You can change the Value to be skin1/skin2/skin3/skin4/skin5/skin6
                    SidebarPosition: true, // it can be true / false ( true means Fixed and false means absolute )
                    HeaderPosition: true, // it can be true / false ( true means Fixed and false means absolute )
                    BoxedLayout: false, // it can be true / false ( true means Boxed and false means Fluid ) 
                });

            });
        </script>
