    <script>
            /************************************/
            //default editor
            /************************************/
            $('.summernote').summernote({
                height: 350, // set editor height
                minHeight: null, // set minimum height of editor
                maxHeight: null, // set maximum height of editor
                focus: false // set focus to editable area after initializing summernote
            });

            /************************************/
            //inline-editor
            /************************************/
            $('.inline-editor').summernote({
                airMode: true
            });

            /************************************/
            //edit and save mode
            /************************************/
            window.edit = function () {
                $(".click2edit").summernote()
            },
                window.save = function () {
                    $(".click2edit").summernote('destroy');
                }

            var edit = function () {
                $('.click2edit').summernote({ focus: true });
            };

            var save = function () {
                var markup = $('.click2edit').summernote('code');
                $('.click2edit').summernote('destroy');
            };

            /************************************/
            //airmode editor
            /************************************/
            $('.airmode-summer').summernote({
                airMode: true
            });
    </script>
        <script>    
            var prm = Sys.WebForms.PageRequestManager.getInstance();
            prm.add_endRequest(prm_endRequest);
            function Approve() {
                toastr.success('Approved', 'Request', { positionClass: 'toastr toast-bottom-left', containerId: 'toast-bottom-left' });
             
            }
            function Info(Header, Details) {
                toastr.info(Details, Header, { positionClass: 'toastr toast-bottom-left', containerId: 'toast-bottom-left' });
               
            }
            function Warning(Header, Details) {
                toastr.Warning(Details, Header, { positionClass: 'toastr toast-bottom-left', containerId: 'toast-bottom-left' });
              
            }
            function Errorss(Details) {
                Swal.fire({
                    type: 'error',
                    title: 'Oops...',
                    text: Details,
                    footer: '<a href>Please take screen shot and send to Admin</a>'
                })
               
            }
            function Reject() {
                toastr.error('Rejected', 'Request', { positionClass: 'toastr toast-bottom-left', containerId: 'toast-bottom-left' });               
            }
            function SaveUpdate(Header, Details) {
                Swal.fire(Header, Details, "success")
            }
            //function SaveUpdate(Header, Details) {
            //    Swal.fire(Header, Details, "success")
            //}
            function Save() {
                
                Swal.fire({
                    position: 'top-end',
                    type: 'success',
                    title: 'Your record has been saved',
                    showConfirmButton: false,
                    timer: 1500
                });
            }
            function Update() {

                Swal.fire({
                    position: 'top-end',
                    type: 'success',
                    title: 'Your record has been updated',
                    showConfirmButton: false,
                    timer: 1500
                });
            }
            function Delete() {

                Swal.fire({
                    position: 'top-end',
                    type: 'success',
                    title: 'Your record has been deleted',
                    showConfirmButton: false,
                    timer: 1500
                });
            }
            function Info() {

                Swal.fire({
                    position: 'top-end',
                    type: 'success',
                    title: 'Record Already Exists',
                    showConfirmButton: false,
                    timer: 1500
                });
            }
            function Details(Details,type) {

                Swal.fire({
                    position: 'top-end',
                    type: type,
                    title: Details,
                    showConfirmButton: false,
                    timer: 1500
                });
            }
            
            function AutoClose2Sec(Header, Details) {
                Swal.fire({
                    title: Header,
                    text: Details,
                    timer: 2000,
                    showConfirmButton: false
                });
            }


            function AutoClose2Sec() {

                Swal.fire({
                    position: 'top-end',
                    type: 'success',
                    title: 'Your work has been saved',
                    showConfirmButton: false,
                    timer: 1500
                });
            }


            function DeleteConfirm() {
                Swal.fire({
                    title: 'Are you sure to delete?',
                    text: "You won't be able to revert this!",
                    type: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Yes, delete it!'
                }).then((result) => {
                    if (result.value) {
                        Swal.fire(
                            'Deleted!',
                            'Your file has been deleted.',
                            'success'
                        )
                    }
                })

            }

           
            
        </script>
        <script type="text/javascript"> 
             $(document).ready(function () {
                 //***********************************//
                 // For select 2
                 //***********************************//
                 $(".select2").select2();
                 /*colorpicker*/
                 $('.demo').each(function () {
                     //
                     // Dear reader, it's actually very easy to initialize MiniColors. For example:
                     //
                     //  $(selector).minicolors();
                     //
                     // The way I've done it below is just for the demo, so don't get confused
                     // by it. Also, data- attributes aren't supported at this time...they're
                     // only used for this demo.
                     //
                     $(this).minicolors({
                         control: $(this).attr('data-control') || 'hue',
                         position: $(this).attr('data-position') || 'bottom left',
                         change: function (value, opacity) {
                             if (!value) return;
                             if (opacity) value += ', ' + opacity;
                             if (typeof console === 'object') {
                                 console.log(value);
                             }
                         },
                         theme: 'bootstrap'
                     });
                 });
                 /*datwpicker*/
                 jQuery('.mydatepicker').datepicker();
                 jQuery('.datepicker-autoclose').datepicker({
                     autoclose: true,
                     todayHighlight: true,
                     locale: {
                         format: 'yyyy-MM-dd'
                     }
                 });
                 var quill = new Quill('#editor', {
                     theme: 'snow'
                 });
             });
             var parameter = Sys.WebForms.PageRequestManager.getInstance();
             parameter.add_endRequest(function () {
                 //***********************************//
                 // For select 2
                 //***********************************//
                 $(".select2").select2();
                 jQuery('.mydatepicker').datepicker();
                 jQuery('.datepicker-autoclose').datepicker({
                     autoclose: true,
                     todayHighlight: true
                 });
             });
             /*colorpicker*/
             $('.demo').each(function () {
                 //
                 // Dear reader, it's actually very easy to initialize MiniColors. For example:
                 //
                 //  $(selector).minicolors();
                 //
                 // The way I've done it below is just for the demo, so don't get confused
                 // by it. Also, data- attributes aren't supported at this time...they're
                 // only used for this demo.
                 //
                 $(this).minicolors({
                     control: $(this).attr('data-control') || 'hue',
                     position: $(this).attr('data-position') || 'bottom left',
                     change: function (value, opacity) {
                         if (!value) return;
                         if (opacity) value += ', ' + opacity;
                         if (typeof console === 'object') {
                             console.log(value);
                         }
                     },
                     theme: 'bootstrap'
                 });
             });
             /*datwpicker*/
             var quill = new Quill('#editor', {
                 theme: 'snow'
             });
        </script>
